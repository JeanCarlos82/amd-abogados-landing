---
import Icon from './Icon.astro';
---
<div id="cookie-banner" class="fixed bottom-0 left-0 right-0 z-[60] p-4 md:p-6 hidden">
  <div class="max-w-4xl mx-auto bg-white border border-burgundy-100 rounded-2xl shadow-2xl p-5 md:p-6 flex flex-col md:flex-row gap-4 md:items-center">
    <div class="flex-1">
      <div class="font-serif font-bold text-burgundy-900 mb-1 flex items-center gap-2"><Icon name="shield-check" size={18} class="text-cream-600" /> Cookies en este sitio</div>
      <p class="text-sm text-burgundy-700 leading-relaxed">
        Utilizamos únicamente cookies técnicas propias para recordar tu preferencia de consentimiento. No instalamos cookies analíticas ni de terceros.
        Consulta nuestra
        <a href="/politica-cookies" class="text-cream-600 underline">política de cookies</a>.
      </p>
    </div>
    <div class="flex gap-2 shrink-0">
      <button id="cookie-reject" class="px-4 py-2.5 text-sm font-semibold text-burgundy-700 border border-burgundy-100 rounded-full hover:bg-burgundy-50 transition">
        Rechazar
      </button>
      <button id="cookie-accept" class="px-5 py-2.5 text-sm font-semibold bg-burgundy-800 hover:bg-burgundy-900 text-white rounded-full transition">
        Aceptar
      </button>
    </div>
  </div>
</div>
<script is:inline>
  (function () {
    const banner = document.getElementById('cookie-banner');
    if (!banner) return;
    const consent = localStorage.getItem('amd-cookie-consent');
    if (!consent) banner.classList.remove('hidden');

    function save(value) {
      localStorage.setItem('amd-cookie-consent', value);
      banner.classList.add('hidden');
    }
    document.getElementById('cookie-accept')?.addEventListener('click', () => save('accepted'));
    document.getElementById('cookie-reject')?.addEventListener('click', () => save('rejected'));
  })();
</script>
