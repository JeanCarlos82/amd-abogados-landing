  <script>
    function setupLanding() {
      // Contact form → Formspree (secure POST, no PII in URL)
      const form = document.getElementById('contact-form') as HTMLFormElement | null;
      if (form) {
        form.addEventListener('submit', async (ev) => {
          ev.preventDefault();
          const data = new FormData(form);
          const statusEl = document.getElementById('cf-status');
          const submitBtn = document.getElementById('cf-submit') as HTMLButtonElement | null;

          // Validate required fields
          const name = (data.get('Nombre') || '').toString().trim();
          const phone = (data.get('Teléfono') || '').toString().trim();
          const email = (data.get('Email') || '').toString().trim();
          const message = (data.get('Consulta') || '').toString().trim();
          const consent = data.get('_consent');
          if (!name || !phone || !email || !message || !consent) {
            form.reportValidity();
            return;
          }

          // Rate limiting (30s between submissions)
          const lastSubmit = sessionStorage.getItem('amd-form-ts');
          if (lastSubmit && Date.now() - Number(lastSubmit) < 30000) {
            if (statusEl) statusEl.innerHTML = '<span class="text-burgundy-600">Por favor, espera unos segundos antes de enviar de nuevo.</span>';
            return;
          }

          // Disable button while sending
          if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Enviando...'; }

          try {
            const res = await fetch(form.action, {
              method: 'POST',
              headers: { 'Accept': 'application/json' },
              body: data,
            });
            if (res.ok) {
              sessionStorage.setItem('amd-form-ts', String(Date.now()));
              form.reset();
              if (statusEl) statusEl.innerHTML = '<span class="text-green-700 font-semibold">✓ Consulta enviada correctamente. Te responderé en menos de 24h.</span>';
            } else {
              if (statusEl) statusEl.innerHTML = '<span class="text-red-700">Error al enviar. Prueba por <a href="https://wa.me/34653413088" class="underline">WhatsApp</a> o <a href="mailto:abrilmartinez@reicaz.com" class="underline">email</a>.</span>';
            }
          } catch {
            if (statusEl) statusEl.innerHTML = '<span class="text-red-700">Error de conexión. Prueba por <a href="https://wa.me/34653413088" class="underline">WhatsApp</a> o <a href="mailto:abrilmartinez@reicaz.com" class="underline">email</a>.</span>';
          } finally {
            if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Enviar mi consulta'; }
          }
        });
      }

      // Scroll-in animations + stat counter count-up
      const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const selector = '[data-animate], [data-counter], [data-stars], [data-icon-pulse]';

      if (!('IntersectionObserver' in window)) {
        document.querySelectorAll(selector).forEach((el) => {
          el.classList.add('in-view');
          const tgt = el.getAttribute('data-target');
          if (tgt) {
            const valueEl = el.querySelector('.counter-value');
            if (valueEl) valueEl.textContent = tgt;
          }
        });
        return;
      }

      const runCounter = (el: Element) => {
        const target = parseInt(el.getAttribute('data-target') || '0', 10);
        const valueEl = el.querySelector('.counter-value');
        if (!valueEl) return;
        if (reduce) { valueEl.textContent = String(target); return; }
        const duration = 1400;
        const startTime = performance.now();
        const tick = (now: number) => {
          const elapsed = now - startTime;
          const progress = Math.min(elapsed / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          valueEl.textContent = String(Math.round(target * eased));
          if (progress < 1) requestAnimationFrame(tick);
          else valueEl.textContent = String(target);
        };
        requestAnimationFrame(tick);
      };

      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            const el = e.target;
            el.classList.add('in-view');
            if (el.hasAttribute('data-counter')) runCounter(el);
            io.unobserve(el);
          });
        },
        { threshold: 0.18, rootMargin: '0px 0px -40px 0px' }
      );
      document.querySelectorAll(selector).forEach((el) => io.observe(el));
    }

    setupLanding();
    document.addEventListener('astro:page-load', setupLanding);
  </script>
