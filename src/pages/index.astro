---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Logo from '../components/Logo.astro';
import Nav from '../components/Nav.astro';
import CookieBanner from '../components/CookieBanner.astro';
import abogadaImg from '../assets/abogada.jpg';

const areas = [
  {
    icon: 'globe',
    title: 'Extranjería',
    lead: 'Para personas migrantes y sus familias que quieren construir su vida en España con garantías.',
    items: [
      'Arraigo social, laboral, familiar y por formación',
      'Regularización extraordinaria',
      'NIE y TIE: obtención, renovación y modificación',
      'Nacionalidad por residencia, matrimonio u origen',
      'Recursos contra denegaciones de nacionalidad',
      'Recursos por retraso de nacionalidad',
      'Reagrupación familiar',
      'Residencia y autorizaciones de trabajo',
      'Recursos contra denegaciones administrativas',
      'Clases de preparación CCSE y DELE',
    ],
  },
  {
    icon: 'scale',
    title: 'Derecho penal',
    lead: 'Defensa y asistencia en procedimientos penales, desde la detención hasta el juicio.',
    items: [
      'Asistencia al detenido en comisaría y juzgado',
      'Defensa en procedimientos abreviados y ordinarios',
      'Acusación particular como víctima',
      'Recursos ante audiencias y tribunales superiores',
    ],
  },
  {
    icon: 'users',
    title: 'Derecho de familia',
    lead: 'Procesos familiares con enfoque práctico y sensibilidad humana en cada paso.',
    items: [
      'Divorcios contenciosos y de mutuo acuerdo',
      'Custodia de menores y régimen de visitas',
      'Pensiones alimenticias y compensatorias',
      'Modificación de medidas definitivas',
    ],
  },
];

const pasos = [
  { n: '01', t: 'Hablamos primero', d: 'Una primera conversación con cita previa para entender tu situación, plazos y opciones reales.' },
  { n: '02', t: 'Análisis de tu caso', d: 'Estudio tu documentación y te explico con claridad tus opciones y plazos.' },
  { n: '03', t: 'Gestión del trámite', d: 'Preparo y presento el expediente, y te mantengo informado en todo momento.' },
  { n: '04', t: 'Resolución favorable', d: 'Te acompaño hasta obtener la respuesta de la Administración.' },
];

const principios = [
  {
    icon: 'shield-check',
    titulo: 'Te digo las cosas como son',
    texto: 'Soy directa y cercana. Te explico tu situación en lenguaje claro, sin jerga jurídica innecesaria, y respondo cuantas dudas tengas. Si la respuesta no te va a gustar, te la doy igual — porque mereces saberla.',
  },
  {
    icon: 'scale',
    titulo: 'Solo cojo casos viables',
    texto: 'Si no veo viabilidad real en tu asunto, te lo digo el primer día y no lo llevo. No trabajo con clientes para ganar dinero a costa de un trámite que va a salir mal. Trabajo solo con casos en los que sé que puedo ayudarte de verdad.',
  },
  {
    icon: 'lock',
    titulo: 'Cuando presento, presento bien',
    texto: 'Si elijo una vía es porque le he dado muchas vueltas a todas las opciones. No experimento con tu expediente. Cuando lo presento, lo hago porque sé que es la estrategia correcta para tu caso — y eso lo nota la Administración.',
  },
];

const faq = [
  {
    q: '¿Cómo es la primera consulta?',
    a: 'Es un análisis real de tu situación, no una llamada de ventas. Ahí te digo si tu caso es viable, qué opciones tienes, los plazos reales y el precio exacto del trámite. Puede ser presencial en mi despacho de Zaragoza con cita previa, o por videollamada si estás fuera.',
  },
  {
    q: '¿Cuánto cuesta un trámite?',
    a: 'Cada caso se valora individualmente — la complejidad del expediente determina el precio final. En la primera consulta te lo digo exactamente, antes de que decidas nada.',
  },
  {
    q: '¿Cuánto tarda la Administración en responder?',
    a: 'Depende del tipo de trámite y de la oficina que lo gestiona. Los arraigos suelen resolverse en 3-6 meses; las nacionalidades pueden tardar de 1 a 3 años. En la consulta te doy una estimación realista para tu caso concreto, no una promesa vacía.',
  },
  {
    q: '¿Puedo viajar mientras mi expediente está en trámite?',
    a: 'Es una de las preguntas que más me hacen y la respuesta depende del tipo de trámite, de tu situación documental y de a dónde quieras viajar. En algunos casos sí, en otros puede comprometer el expediente. Lo vemos en la primera consulta antes de que reserves nada.',
  },
  {
    q: '¿Cómo sabes si mi caso va a salir bien?',
    a: 'Antes de aceptar un caso lo estudio a fondo: documentación, antecedentes, normativa aplicable. Si no veo viabilidad real, te lo digo el primer día y no llevo el caso. No trabajo con expedientes que sé que van a salir mal — ni por dinero. Si te confirmo que tu caso es viable, es porque he valorado todas las opciones y sé cuál es la vía correcta.',
  },
  {
    q: '¿Atiendes a clientes fuera de Zaragoza?',
    a: 'Sí. Puedo presentar trámites en toda España. Los clientes de fuera me contactan por teléfono y concertamos una cita virtual (llamada o videollamada) para hacer la consulta inicial. Toda la documentación se gestiona de forma segura.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faq.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};
---
<Layout>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  <Nav overHero={true} />

  <main id="main">
  <!-- HERO -->
  <section class="relative overflow-hidden bg-burgundy-900 text-white">
    <!-- Watermark caligráfico "Amd" con drift lento permanente -->
    <div aria-hidden="true" class="pointer-events-none absolute -right-16 -top-10 md:-right-24 md:-top-16 select-none font-logo text-[18rem] md:text-[26rem] leading-none text-cream-300/5 watermark-drift">Amd</div>
    <!-- Gradiente radial suave -->
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top_left,_theme(colors.burgundy.800)_0%,_transparent_60%)]"></div>

    <div class="relative max-w-6xl mx-auto px-6 py-24 md:py-32 grid md:grid-cols-[1.1fr_1fr] gap-12 md:gap-16 items-center">
      <div>
        <div data-animate data-mode="down" class="inline-flex items-center gap-2 bg-cream-300/10 text-cream-300 text-xs font-semibold uppercase tracking-[0.15em] px-4 py-2 rounded-full mb-8 border border-cream-300/20">
          <span class="w-1.5 h-1.5 bg-cream-300 rounded-full animate-pulse"></span>
          Abogada colegiada · REICAZ
        </div>
        <h1 data-animate data-mode="rise" data-animate-delay="1" class="font-serif text-5xl md:text-6xl lg:text-7xl font-semibold leading-[1.02] tracking-tight mb-8">
          Tu situación legal<br/>
          <span class="text-cream-300">tiene solución.</span>
        </h1>
        <p data-animate data-animate-delay="2" class="text-lg md:text-xl text-cream-100/80 mb-10 leading-relaxed max-w-xl">
          Soy <strong class="text-white font-semibold">Abril Martínez Decena</strong>, abogada en Zaragoza especializada en <strong class="text-white font-semibold">extranjería, derecho penal y derecho de familia</strong>. Atiendo en toda España, en español o francés. Te digo las cosas como son y solo cojo casos en los que sé que puedo ayudarte de verdad.
        </p>
        <div data-animate data-animate-delay="3" class="flex flex-wrap gap-4 mb-10">
          <a href="#contacto" class="group inline-flex items-center gap-2 bg-cream-300 hover:bg-cream-200 text-burgundy-900 font-semibold px-8 py-4 rounded-full shadow-xl shadow-burgundy-950/40 transition hover:-translate-y-0.5">
            Hablar con Abril
            <Icon name="arrow-right" size={18} class="group-hover:translate-x-1 transition-transform" />
          </a>
          <a href="tel:+34653413088" class="inline-flex items-center gap-2 border-2 border-cream-300/40 text-cream-100 hover:bg-cream-300/10 hover:border-cream-300 font-semibold px-8 py-4 rounded-full transition hover:-translate-y-0.5">
            <Icon name="phone" size={18} />
            653 41 30 88
          </a>
        </div>
        <div data-animate data-animate-delay="4" class="flex flex-wrap gap-x-8 gap-y-3 text-sm text-cream-100/80 pt-6 border-t border-cream-300/15">
          <div class="flex items-center gap-2"><Icon name="shield-check" size={16} class="text-cream-300" /> Colegiada REICAZ nº 7237</div>
          <div class="flex items-center gap-2"><Icon name="check" size={16} class="text-cream-300" /> Extranjería · Penal · Familia</div>
          <div class="flex items-center gap-2"><Icon name="check" size={16} class="text-cream-300" /> Atiendo en español y francés</div>
        </div>
      </div>

      <!-- Retrato tipo ficha -->
      <div class="relative mx-auto max-w-sm md:max-w-none" data-animate data-mode="scale" data-animate-delay="2">
        <!-- Marco decorativo cream -->
        <div aria-hidden="true" class="absolute -inset-3 md:-inset-4 border border-cream-300/30 rounded-3xl rotate-2"></div>
        <div aria-hidden="true" class="absolute -inset-1.5 md:-inset-2 border border-cream-300/50 rounded-3xl -rotate-1"></div>

        <div class="relative aspect-[4/5] rounded-2xl shadow-2xl shadow-burgundy-950/60 overflow-hidden bg-burgundy-800 ring-1 ring-cream-300/20">
          <Image
            src={abogadaImg}
            alt="Abril Martínez Decena, abogada de extranjería en Zaragoza"
            widths={[400, 640, 800, 1000]}
            sizes="(max-width: 768px) 90vw, 40vw"
            format="webp"
            quality={82}
            loading="eager"
            fetchpriority="high"
            class="w-full h-full object-cover"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-burgundy-950/90 via-burgundy-950/30 to-transparent"></div>
          <!-- Ficha tipo expediente -->
          <div class="absolute bottom-6 left-6 right-6 text-white">
            <div class="text-[11px] uppercase tracking-[0.2em] text-white font-semibold pb-4 mb-4 border-b border-cream-300/25 drop-shadow-[0_1px_2px_rgba(0,0,0,0.6)]">Abogada colegiada · REICAZ 7237</div>
            <div class="font-serif text-2xl font-semibold leading-tight">Abril Martínez<br/>Decena</div>
          </div>
        </div>

        <!-- Floating trust badge con shimmer permanente -->
        <div class="absolute -bottom-6 -left-4 md:-left-8 bg-cream-50 rounded-xl px-5 py-4 border border-cream-200 flex items-center gap-4 badge-shimmer">
          <div class="w-10 h-10 rounded-full bg-burgundy-800 flex items-center justify-center text-cream-300 shrink-0">
            <Icon name="award" size={20} />
          </div>
          <div>
            <div class="text-xl font-serif font-bold text-burgundy-900 leading-none">REICAZ</div>
            <div class="text-[11px] uppercase tracking-wider text-burgundy-700/80 mt-1">Colegiada nº 7237</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TRUST BAR (stat counters) -->
  <section class="bg-burgundy-900 text-white border-y border-cream-600/20">
    <div class="max-w-6xl mx-auto px-6 py-12 grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
      <div data-counter data-target="24" data-suffix="h">
        <div class="text-4xl font-serif font-bold text-cream-300 tabular-nums"><span class="counter-value">0</span><span class="counter-suffix">h</span></div>
        <div class="text-sm text-cream-100/70 mt-2 uppercase tracking-wider">Respuesta media</div>
      </div>
      <div data-counter data-target="100" data-suffix="%">
        <div class="text-4xl font-serif font-bold text-cream-300 tabular-nums"><span class="counter-value">0</span><span class="counter-suffix">%</span></div>
        <div class="text-sm text-cream-100/70 mt-2 uppercase tracking-wider">Confidencialidad</div>
      </div>
      <div data-counter data-target="2" data-suffix="">
        <div class="text-4xl font-serif font-bold text-cream-300 tabular-nums"><span class="counter-value">0</span></div>
        <div class="text-sm text-cream-100/70 mt-2 uppercase tracking-wider">Idiomas atendidos</div>
      </div>
      <div data-counter data-target="3" data-suffix="">
        <div class="text-4xl font-serif font-bold text-cream-300 tabular-nums"><span class="counter-value">0</span></div>
        <div class="text-sm text-cream-100/70 mt-2 uppercase tracking-wider">Áreas de derecho</div>
      </div>
    </div>
  </section>

  <!-- CREDENTIALS STRIP (Trust & Authority: expose credentials prominently) -->
  <section class="bg-cream-50 border-b border-burgundy-100">
    <div class="max-w-6xl mx-auto px-6 py-8">
      <div class="flex flex-wrap items-center justify-center gap-x-10 gap-y-5 text-burgundy-800">
        <div class="flex items-center gap-3" data-animate data-mode="right" data-animate-delay="1">
          <span data-icon-pulse><Icon name="shield-check" size={22} class="text-cream-600 shrink-0" /></span>
          <div>
            <div class="text-xs uppercase tracking-wider text-burgundy-700/70">Colegiada</div>
            <div class="text-sm font-semibold">REICAZ</div>
          </div>
        </div>
        <div class="hidden md:block w-px h-10 bg-burgundy-200"></div>
        <div class="flex items-center gap-3" data-animate data-mode="right" data-animate-delay="2">
          <span data-icon-pulse><Icon name="scale" size={22} class="text-cream-600 shrink-0" /></span>
          <div>
            <div class="text-xs uppercase tracking-wider text-burgundy-700/70">Áreas</div>
            <div class="text-sm font-semibold">Extranjería · Penal · Familia</div>
          </div>
        </div>
        <div class="hidden md:block w-px h-10 bg-burgundy-200"></div>
        <div class="flex items-center gap-3" data-animate data-mode="right" data-animate-delay="3">
          <span data-icon-pulse><Icon name="lock" size={22} class="text-cream-600 shrink-0" /></span>
          <div>
            <div class="text-xs uppercase tracking-wider text-burgundy-700/70">Confidencialidad</div>
            <div class="text-sm font-semibold">Secreto profesional</div>
          </div>
        </div>
        <div class="hidden md:block w-px h-10 bg-burgundy-200"></div>
        <div class="flex items-center gap-3" data-animate data-mode="right" data-animate-delay="4">
          <span data-icon-pulse><Icon name="check" size={22} class="text-cream-600 shrink-0" /></span>
          <div>
            <div class="text-xs uppercase tracking-wider text-burgundy-700/70">Atención</div>
            <div class="text-sm font-semibold">Solo con cita previa</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICIOS / ÁREAS DE PRÁCTICA -->
  <section id="servicios" class="py-24 bg-white">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-16" data-animate>
        <div class="text-cream-600 text-xs font-semibold uppercase tracking-[0.2em] mb-4">— Áreas de práctica —</div>
        <h2 class="font-serif text-4xl md:text-5xl font-semibold text-burgundy-900 mb-5 tracking-tight">En qué puedo ayudarte</h2>
        <p class="text-burgundy-700 max-w-2xl mx-auto text-lg">Tres áreas del derecho con un mismo enfoque: trato cercano, claridad y rigor técnico en cada paso.</p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
        {areas.map((a, i) => (
          <article data-animate data-mode="rise" data-animate-delay={String(i + 1)} class="group relative flex flex-col bg-cream-50/60 rounded-2xl p-8 lg:p-9 border border-burgundy-100 hover:border-burgundy-300 lift-on-hover overflow-hidden">
            <!-- Top accent bar -->
            <div aria-hidden="true" class="absolute top-0 left-0 right-0 h-1 bg-burgundy-800 group-hover:bg-cream-600 transition-colors duration-300"></div>
            <!-- Icon in circle -->
            <div class="relative w-16 h-16 rounded-full bg-burgundy-50 flex items-center justify-center text-burgundy-800 mb-6 ring-1 ring-burgundy-100 group-hover:bg-burgundy-800 group-hover:text-cream-300 group-hover:ring-burgundy-800 transition-all duration-300">
              <span class="icon-tilt inline-flex"><Icon name={a.icon} size={28} /></span>
            </div>
            <h3 class="font-serif text-2xl md:text-3xl font-semibold text-burgundy-900 mb-3 tracking-tight">{a.title}</h3>
            <p class="text-burgundy-700 text-sm leading-relaxed mb-6 italic">{a.lead}</p>
            <ul class="space-y-2.5 mb-8 flex-1">
              {a.items.map((item) => (
                <li class="flex gap-2.5 items-start text-sm text-burgundy-800">
                  <Icon name="check" size={16} class="text-cream-600 shrink-0 mt-0.5" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
            <a href="#contacto" class="mt-auto inline-flex items-center gap-1.5 text-sm font-semibold text-burgundy-800 hover:text-cream-600 transition-colors">
              Consultar mi caso
              <Icon name="arrow-right" size={14} class="group-hover:translate-x-1 transition-transform" />
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- SOBRE MI -->
  <section id="sobre-mi" class="py-24 bg-burgundy-50">
    <div class="max-w-6xl mx-auto px-6 grid md:grid-cols-5 gap-12 items-center">
      <div class="md:col-span-2" data-animate data-mode="left">
        <div class="aspect-square rounded-2xl shadow-xl overflow-hidden bg-burgundy-100 ring-4 ring-white">
          <Image
            src={abogadaImg}
            alt="Abril Martínez Decena en su despacho"
            widths={[300, 500, 700]}
            sizes="(max-width: 768px) 90vw, 30vw"
            format="webp"
            quality={80}
            loading="lazy"
            class="w-full h-full object-cover"
          />
        </div>
      </div>
      <div class="md:col-span-3">
        <div data-animate data-mode="right" class="text-cream-600 text-sm font-semibold uppercase tracking-wider mb-3">Sobre mí</div>
        <h2 data-animate data-mode="right" data-animate-delay="1" class="font-serif text-4xl md:text-5xl font-semibold text-burgundy-900 mb-6 tracking-tight">Soy Abril. Y entiendo lo que estás viviendo.</h2>

        <p data-animate data-mode="right" data-animate-delay="2" class="text-burgundy-700 mb-5 leading-relaxed text-lg">
          Llegar a un país nuevo, llenar formularios en un idioma que no es el tuyo, esperar meses una respuesta que no llega, escuchar versiones distintas dependiendo de a quién preguntes, sentir que tu vida entera depende de un papel sellado. Si has llegado hasta aquí buscando una abogada, lo más probable es que estés <strong>cansado, asustado, o las dos cosas a la vez</strong>.
        </p>

        <p data-animate data-mode="right" data-animate-delay="3" class="text-burgundy-700 mb-5 leading-relaxed text-lg italic">
          Yo también he estado al otro lado del mostrador. Por eso te entiendo.
        </p>

        <p data-animate data-mode="right" data-animate-delay="4" class="text-burgundy-700 mb-5 leading-relaxed">
          Soy abogada colegiada en REICAZ con el número <strong>7237</strong>. Estudié Derecho en Burgos, hice el máster de acceso a la abogacía en Zaragoza y desde <strong>2023</strong> ejerzo aquí. Pero antes de todo eso fui — y sigo siendo — migrante. Por eso elegí especializarme en <strong>extranjería</strong>: porque para mí no es una carrera profesional, es la forma más concreta que tengo de devolver algo a mi propia comunidad.
        </p>

        <p data-animate data-mode="right" data-animate-delay="5" class="text-burgundy-700 mb-5 leading-relaxed">
          Cuando llevo tu caso no me limito a presentar un expediente y desaparecer hasta que llegue la respuesta. Te explico cada paso en lenguaje claro, te cuento qué puede pasar y qué no, y si veo que tu situación no tiene salida real, <strong>te lo digo el primer día</strong>. Prefiero perder un cliente a llevarte por un camino que sé que va a salir mal.
        </p>

        <p data-animate data-mode="right" data-animate-delay="6" class="text-burgundy-700 mb-5 leading-relaxed">
          Trabajo también <strong>derecho penal</strong> y <strong>derecho de familia</strong> porque la vida de una persona migrante rara vez cabe en un solo expediente: se cruzan custodias, divorcios, denuncias, recursos. Te llevo el caso de forma integral, sin que tengas que correr de despacho en despacho contando tu historia desde cero cada vez.
        </p>

        <p data-animate data-mode="right" data-animate-delay="7" class="text-burgundy-700 mb-7 leading-relaxed">
          Y porque sé que la nacionalidad no termina cuando presentas el expediente, sino cuando apruebas los exámenes, también te <strong>preparo para el CCSE y el DELE</strong>. Mi trabajo no es papelear. Es acompañarte hasta el final.
        </p>

        <ul class="space-y-3 text-burgundy-700">
          <li data-animate data-animate-delay="8" class="flex gap-3 items-start"><Icon name="shield-check" size={20} class="text-cream-600 shrink-0 mt-0.5" /> Colegiada en el Real e Ilustre Colegio de Abogados de Zaragoza (REICAZ), nº 7237</li>
          <li data-animate data-animate-delay="8" class="flex gap-3 items-start"><Icon name="shield-check" size={20} class="text-cream-600 shrink-0 mt-0.5" /> Atiendo en español y francés</li>
          <li data-animate data-animate-delay="8" class="flex gap-3 items-start"><Icon name="shield-check" size={20} class="text-cream-600 shrink-0 mt-0.5" /> Despacho en Zaragoza · Atención en toda España con cita previa</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- PROCESO -->
  <section id="proceso" class="py-24 bg-cream-50">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-20">
        <div data-animate class="text-cream-600 text-xs font-semibold uppercase tracking-[0.2em] mb-4">— Cómo trabajo —</div>
        <h2 data-animate data-mode="rise" data-animate-delay="1" class="font-serif text-4xl md:text-5xl font-semibold text-burgundy-900 tracking-tight">Tu caso, en 4 pasos claros</h2>
      </div>
      <div class="relative">
        <!-- Connector line (desktop only) — draws left-to-right on view -->
        <div aria-hidden="true" data-animate data-mode="draw" data-animate-delay="2" class="hidden md:block absolute top-8 left-[12.5%] right-[12.5%] h-px bg-gradient-to-r from-transparent via-burgundy-400 to-transparent"></div>
        <div class="grid md:grid-cols-4 gap-8 md:gap-6 relative">
          {pasos.map((p, i) => (
            <div class="relative flex flex-col items-center text-center">
              <!-- Number circle: scale-in with bounce -->
              <div data-animate data-mode="scale" data-animate-delay={String(i + 2)} class="relative z-10 w-16 h-16 rounded-full bg-burgundy-800 text-cream-300 flex items-center justify-center font-serif text-xl font-bold shadow-lg shadow-burgundy-900/30 ring-4 ring-cream-50 mb-5">
                {p.n}
              </div>
              <h3 data-animate data-animate-delay={String(i + 3)} class="font-serif text-xl font-semibold text-burgundy-900 mb-3 px-2">{p.t}</h3>
              <p data-animate data-animate-delay={String(i + 4)} class="text-sm text-burgundy-700 leading-relaxed max-w-[220px]">{p.d}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- COMPROMISO -->
